local Window = AxionLibrary:CreateWindow({
    Name = "PRIVATE SERVERS",
    Subtitle = "by Delta Utility",
    Version = "v2.0"
})

local MainTab = Window:CreateTab("Server Hopper")

-- Display Player Status Info
local StatusLabel = MainTab:CreateLabel("Current Server: " .. #Players:GetPlayers() .. " player(s)")

-- Threshold Setting Options
local maxPlayers = 1
MainTab:CreateInput("Max Target Players", "1", function(val)
    maxPlayers = tonumber(val) or 1
end)

local autoDetectThreshold = 3
MainTab:CreateInput("Auto Hop Player Limit", "3", function(val)
    autoDetectThreshold = tonumber(val) or 3
end)

local searching = false
local HopBtnRef

local function FindAndJoinServer(buttonRef)
    if searching then return end
    searching = true
    
    local placeId = game.PlaceId
    local currentJob = game.JobId
    
    local targetBtn = buttonRef or HopBtnRef
    if targetBtn then targetBtn.Text = "SEARCHING..." end
    
    task.spawn(function()
        local cursor = ""
        local pagesToSkip = math.random(5, 12)
        local targetServer = nil
        
        for i = 1, pagesToSkip do
            local url = "https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=Desc&limit=100" .. (cursor ~= "" and ("&cursor=" .. cursor) or "")
            local reqSuccess, rawData = pcall(function() return game:HttpGet(url) end)
            if reqSuccess and rawData then
                local decodeSuccess, decoded = pcall(function() return HttpService:JSONDecode(rawData) end)
                if decodeSuccess and decoded and decoded.nextPageCursor then
                    cursor = decoded.nextPageCursor
                else
                    break
                end
            else
                break
            end
        end
        
        local searchUrl = "https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=Asc&limit=100" .. (cursor ~= "" and ("&cursor=" .. cursor) or "")
        local reqSuccess, rawData = pcall(function() return game:HttpGet(searchUrl) end)
        
        if reqSuccess and rawData then
            local decodeSuccess, decoded = pcall(function() return HttpService:JSONDecode(rawData) end)
            if decodeSuccess and decoded and decoded.data then
                local candidates = {}
                for _, server in ipairs(decoded.data) do
                    if server.id ~= currentJob and server.playing <= maxPlayers and server.playing > 0 then
                        table.insert(candidates, server)
                    end
                end
                
                if #candidates > 0 then
                    table.sort(candidates, function(a, b) return a.playing < b.playing end)
                    targetServer = candidates[1]
                end
            end
        end
        
        if targetServer then
            if targetBtn then targetBtn.Text = "JOINING (" .. targetServer.playing .. ")..." end
            TeleportService:TeleportToPlaceInstance(placeId, targetServer.id, LocalPlayer)
        else
            if targetBtn then targetBtn.Text = "RETRYING..." end
            task.wait(0.5)
            searching = false
            FindAndJoinServer(targetBtn)
        end
    end)
end

-- Primary Hop Action Button
HopBtnRef = MainTab:CreateButton("HOP SERVER NOW", function()
    FindAndJoinServer(HopBtnRef)
end)

-- Auto Detect Toggle and Detection Logic
local autoDetectActive = false

local function CheckPlayerThreshold()
    local currentCount = #Players:GetPlayers()
    StatusLabel.Text = "Current Server: " .. currentCount .. " player(s)"
    
    if autoDetectActive and currentCount >= autoDetectThreshold then
        FindAndJoinServer(HopBtnRef)
    end
end

MainTab:CreateToggle("AUTO DETECT HOP", false, function(state)
    autoDetectActive = state
    if autoDetectActive then
        CheckPlayerThreshold()
    end
end)

Players.PlayerAdded:Connect(CheckPlayerThreshold)
Players.PlayerRemoving:Connect(CheckPlayerThreshold)

-- Automated Background Server Switcher
local autoHopActive = false
MainTab:CreateToggle("AUTO HOP", false, function(state)
    autoHopActive = state
    if autoHopActive then
        FindAndJoinServer(HopBtnRef)
    end
end)

