 local TweenService = game:GetService("TweenService")

local gui = Instance.new("ScreenGui")
gui.Name = "UpdateMessage"
gui.ResetOnSpawn = false
gui.Parent = game:GetService("CoreGui")

local text = Instance.new("TextLabel")
text.Size = UDim2.new(1, 0, 0, 60)
text.Position = UDim2.new(0, 0, 0.45, 0)
text.BackgroundTransparency = 1
text.Text = "Please wait, we are currently fixing something."
text.TextColor3 = Color3.fromRGB(255, 255, 255)
text.TextTransparency = 1
text.TextScaled = true
text.Font = Enum.Font.GothamBold
text.Parent = gui

-- Fade in
TweenService:Create(text, TweenInfo.new(0.6), {
    TextTransparency = 0
}):Play()

task.wait(3)

-- Fade out
local fadeOut = TweenService:Create(text, TweenInfo.new(0.6), {
    TextTransparency = 1
})

fadeOut:Play()
fadeOut.Completed:Wait()

gui:Destroy()
